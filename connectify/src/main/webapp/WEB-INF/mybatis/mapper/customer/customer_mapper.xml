<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="customer_mapper">

<!-- 사용자 id 찾기 -->
    <select id="findById" parameterType="string" resultType="Customer">
        SELECT *
        FROM CON_T_USER
        WHERE id = #{id}
    </select>
    
<!-- 사용자 id, pw 일치 확인 -->
	<select id="checkCustomerLogin" resultType="Customer" parameterType="Customer">
		SELECT * FROM CON_T_USER
		WHERE id = #{id} AND pw = #{pw}
	</select>

<!-- 회원가입 -->
    <insert id="signup" parameterType="Customer">
		INSERT INTO CON_T_USER VALUES ( 
				#{id},
				#{pw},
				#{name}, 
				#{tel},
				#{mail},
				NULL,
				SYSDATE,
				NULL,
				0)
    </insert>

</mapper>